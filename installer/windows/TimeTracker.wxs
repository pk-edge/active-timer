<!--
  TimeTracker Windows Installer — WiX v4/v7
  Built by: build_windows.ps1
  Version is passed via -dVersion="X.Y.Z" at build time.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="TimeTracker" Language="1033"
           Version="$(var.Version)" Manufacturer="EDGE"
           UpgradeCode="B4F8A1C2-3D7E-4F0A-8B2C-9E1D5F6A7B3C"
           Scope="perUser">

    <SummaryInformation Description="TimeTracker Agent v$(var.Version)"
                        Comments="Activity tracking agent for the TimeTracker platform" />

    <!-- Always upgrade: remove older version before installing new one -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of TimeTracker is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- UI: minimal wizard -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" Overridable="yes" />

    <!-- Kill any running instance before install/upgrade to avoid locked-file errors -->
    <util:CloseApplication Id="CloseTimeTracker" Target="timetracker.exe"
                           CloseMessage="yes" RebootPrompt="no" />

    <!-- Directory structure -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLDIR" Name="TimeTracker" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TimeTracker" />
    </StandardDirectory>

    <!-- Main executable component -->
    <Component Id="TimeTrackerExe" Directory="INSTALLDIR"
               Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
      <File Id="TimeTrackerEXE" Source="$(var.DistDir)\timetracker.exe" KeyPath="yes" />
      <!-- Registry: run at login -->
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="TimeTracker" Type="string"
                     Value="&quot;[INSTALLDIR]timetracker.exe&quot;"
                     KeyPath="no" />
      <!-- Remove the Run key on uninstall -->
      <RemoveRegistryValue Root="HKCU"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="TimeTracker" />
    </Component>

    <!-- Start-menu shortcut -->
    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder"
               Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="TimeTracker"
                Description="TimeTracker Activity Monitor"
                Target="[INSTALLDIR]timetracker.exe"
                WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\TimeTracker"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Feature: full install -->
    <Feature Id="ProductFeature" Title="TimeTracker" Level="1">
      <ComponentRef Id="TimeTrackerExe" />
      <ComponentRef Id="ApplicationShortcut" />
      <!-- File components generated from dist directory -->
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>

    <!--
      Clear stored identity on install/upgrade so the agent re-enrolls fresh
      against the backend configured in backends.json. This ensures a URL or
      token change in backends.json always takes effect without manual cleanup.
      identity.json lives in %APPDATA%\TimeTracker\ (Config.BASE_DIR).
    -->
    <CustomAction Id="ClearIdentity" Script="jscript" ScriptSourceFile="clear_identity.js" Return="ignore" />

    <!-- Launch on finish -->
    <CustomAction Id="LaunchAgent" FileRef="TimeTrackerEXE" ExeCommand=""
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="ClearIdentity" Before="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="LaunchAgent" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
