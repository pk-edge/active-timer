.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
agent/enrollment_token.txt
agent/identity.json
backend/secrets/*.json
backend/secrets/*.p12
backend/secrets/*.pem
backend/secrets/*.key

