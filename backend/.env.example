# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/timetracker

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_DEVICE_EXPIRE_DAYS=365
JWT_ADMIN_EXPIRE_HOURS=12

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=timetracker-screenshots
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=

# Online detection — seconds since last sync before a device is marked offline
ONLINE_CUTOFF_SECS=30

# CORS — defaults to "*" (allow all). Restrict in production:
# CORS_ORIGINS=https://dashboard.yourdomain.com
# CORS_ORIGINS=["https://dashboard.yourdomain.com","https://admin.yourdomain.com"]
