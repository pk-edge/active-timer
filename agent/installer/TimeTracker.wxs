<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 MSI definition for TimeTracker Windows agent.
  Built by build_windows.ps1 which also generates installer\AppFiles.wxs
  via "wix harvest dir".

  UpgradeCode must NEVER change — it identifies the product family across versions.
  Version is injected by build_windows.ps1 via -define "Version=x.y.z".
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="TimeTracker"
      Version="$(Version)"
      Manufacturer="Edge"
      UpgradeCode="C4A2F1E0-8B3D-4F9A-B6E5-D1C2A3F4B5E6"
      Language="1033"
      Codepage="1252"
      Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <!-- Silent upgrade: remove older version first, then install new one -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of TimeTracker is already installed."
        Schedule="afterInstallInitialize" />

    <!-- Minimal UI: licence + progress + finish -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- ── Directory layout ──────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="EdgeFolder" Name="Edge">
        <Directory Id="INSTALLFOLDER" Name="TimeTracker" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="TimeTracker" />
    </StandardDirectory>

    <!-- ── Features ──────────────────────────────────────────────────────── -->
    <Feature Id="Complete" Title="TimeTracker" Level="1">
      <!-- AppFiles ComponentGroup is generated by "wix harvest dir" in build_windows.ps1 -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- ── Start Menu shortcut ───────────────────────────────────────────── -->
    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="D5E3A1B2-C4F6-4A8B-9D2E-F1C3A5B7D9E0">
        <Shortcut Id="AppShortcut"
                  Name="TimeTracker"
                  Description="Edge TimeTracker agent"
                  Target="[INSTALLFOLDER]timetracker.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenu" Directory="AppMenuFolder" On="uninstall" />
        <!-- Registry key-path required by WiX for this component -->
        <RegistryValue
            Root="HKCU"
            Key="Software\Edge\TimeTracker"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Launch the app when the installer finishes (on install, not repair/uninstall) -->
    <CustomAction Id="LaunchApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]timetracker.exe"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize">
        NOT Installed AND NOT REMOVE
      </Custom>
    </InstallExecuteSequence>

    <!--
      Auto-start (registry Run key) is written by the agent itself on first launch
      via autostart.py — no need to duplicate it here.
    -->

  </Package>
</Wix>
