# ── Database ───────────────────────────────────────────────────────────────────
# Password used by docker-compose for the Postgres container
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change_me_to_a_long_random_string

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Leave blank to use IAM role / instance profile (recommended for EC2/ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=timetracker-screenshots
# Internal MinIO URL (used by backend to talk to MinIO inside Docker)
S3_ENDPOINT_URL=http://minio:9000
# External MinIO URL (used to generate presigned URLs that agents can reach)
# For local dev: http://localhost:9000  — For production: leave blank (uses real S3)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# ── URLs (set after your EC2/ELB is provisioned) ──────────────────────────────
# URL the backend is publicly reachable at (used by agents + CORS)
API_URL=https://api.yourdomain.com
# URL the dashboard is publicly reachable at (used for CORS)
DASHBOARD_URL=https://dashboard.yourdomain.com
